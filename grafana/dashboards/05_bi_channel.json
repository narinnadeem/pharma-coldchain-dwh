   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT a.channel_group || ' generates ' || a.share || '% of net sales. Overall gross margin is ' || ROUND(k.gross_margin_pct,2) || '% (' || CASE WHEN k.gross_margin_pct >= 21.0 THEN 'on target' ELSE 'below 21% target' END || '); margin spread across channels is only ' || ROUND(b.spread,2) || ' pts - channel growth is driven by volume.' AS takeaway FROM (SELECT * FROM bi.refresh_history ORDER BY refresh_no DESC LIMIT 1) k, (SELECT channel_group, share FROM (SELECT channel_group, SUM(net_sales) AS ns, SUM(gross_margin) AS gm, SUM(units_sold) AS u, SUM(transactions) AS tx, ROUND(SUM(gross_margin)*100.0/NULLIF(SUM(net_sales),0),2) AS m, ROUND(SUM(net_sales)*100.0/SUM(SUM(net_sales)) OVER (),1) AS share FROM bi.channel_monthly GROUP BY 1) x ORDER BY ns DESC LIMIT 1) a, (SELECT MAX(m) - MIN(m) AS spread FROM (SELECT channel_group, SUM(net_sales) AS ns, SUM(gross_margin) AS gm, SUM(units_sold) AS u, SUM(transactions) AS tx, ROUND(SUM(gross_margin)*100.0/NULLIF(SUM(net_sales),0),2) AS m, ROUND(SUM(net_sales)*100.0/SUM(SUM(net_sales)) OVER (),1) AS share FROM bi.channel_monthly GROUP BY 1) y) b"
    }
   ]
  },
