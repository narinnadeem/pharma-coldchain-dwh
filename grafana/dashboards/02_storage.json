   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT COALESCE(SUM(row_count), 0) AS rows FROM staging.metrics_storage WHERE layer = 'staging' AND table_name <> 'stg_rejected_records' AND snapshot_ts = (SELECT MAX(snapshot_ts) FROM staging.metrics_storage)"
