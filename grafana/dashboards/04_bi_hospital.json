   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT 'Hospitals consumed ' || ROUND(k.consumption_ratio_pct,1) || '% of forecast (' || CASE WHEN k.consumption_ratio_pct >= 95.0 THEN 'on target' ELSE 'below 95% target' END || '); ' || ROUND(k.unfulfilled_pct,2) || '% went unfulfilled (' || CASE WHEN k.unfulfilled_pct <= 2.5 THEN 'within' ELSE 'above' END || ' 2.5% limit). Largest gap: ' || t.hospital_name || ' (' || TO_CHAR(t.u, 'FM999,999') || ' packs).' AS takeaway FROM (SELECT * FROM bi.refresh_history ORDER BY refresh_no DESC LIMIT 1) k, (SELECT hospital_name, SUM(unfulfilled_packs) AS u FROM bi.hospital_monthly GROUP BY 1 ORDER BY 2 DESC LIMIT 1) t"
    }
   ]
  },
