 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Batch success rate (%)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE status = 'SUCCESS') / NULLIF(COUNT(*), 0), 1) AS success_rate_pct FROM staging.pipeline_metrics_batch"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "orientation": "auto"
   }
  },
