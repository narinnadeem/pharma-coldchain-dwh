  {
   "id": 7,
   "type": "barchart",
   "title": "Batch load duration per file (seconds, latest load)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT source_file, duration_seconds FROM (SELECT DISTINCT ON (source_file) source_file, duration_seconds, rows_processed, created_at FROM staging.pipeline_metrics_batch WHERE status = 'SUCCESS' ORDER BY source_file, created_at DESC) t ORDER BY duration_seconds DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
